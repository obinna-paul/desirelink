# Canonical production URL (lib/site-config.ts) — used for sitemap/OG/canonical
# links. Falls back to NEXTAUTH_URL, then the known production domain, so this
# only needs to be set if the two ever diverge.
NEXT_PUBLIC_APP_URL=""

# Payments (lib/payments) — see lib/payments/index.ts for how these are used.
#
# Set USE_MOCK_PAYMENTS=true to use the in-memory mock provider for local
# development; no real payment account is needed in that case.
#
# Paystack is the active real provider.
USE_MOCK_PAYMENTS="true"

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Use a live secret key (sk_live_...) in production, test (sk_test_...) elsewhere.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Every price in this app is displayed in Naira (see lib/creator.ts's formatCents,
# which formats with Intl currency "NGN") — this MUST stay "NGN" to match, since a
# mismatch charges in a currency the merchant account likely isn't approved for and
# every transaction fails. Most Nigerian Paystack accounts are NGN-only.
PAYSTACK_CURRENCY="NGN"
#
# After deploying, register the webhook URL in the Paystack dashboard
# (Settings -> API Keys & Webhooks): https://<your-domain>/api/webhooks/paystack

# Live streaming (lib/livekit.ts) — https://cloud.livekit.io (free tier
# available). Leave unset to disable live streaming; the "Host" ring on Home
# and the /live routes show a friendly "not configured" state instead.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Provider rewards pool (app/api/cron/monthly-rewards) and the recurring
# billing renewal job (app/api/cron/subscription-renewals) — required in
# production to authorize the cron request (Authorization: Bearer
# <CRON_SECRET>). Left unset, these routes allow unauthenticated calls
# outside production only.
CRON_SECRET=""

# Email (lib/email) — https://resend.com, sending on the udala.pro domain.
# Leave unset to skip sending (logged and swallowed, never blocks the action
# that triggered it) — useful for local dev without a Resend account.
RESEND_API_KEY=""
# How long a signup/password-reset code stays valid.
EMAIL_OTP_TTL_MINUTES="10"
