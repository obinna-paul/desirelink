# Payments (lib/payments) — see lib/payments/index.ts for how these are used.
#
# Set USE_MOCK_PAYMENTS=true to use the in-memory mock provider for local
# development; no Stripe account is needed in that case. Set it to false (or
# unset) to use the real Stripe provider, which then requires the three
# Stripe variables below.
USE_MOCK_PAYMENTS="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# Provider rewards pool (app/api/cron/monthly-rewards) — required in production
# to authorize the monthly cron request (Authorization: Bearer <CRON_SECRET>).
# Left unset, the route allows unauthenticated calls outside production only.
CRON_SECRET=""
