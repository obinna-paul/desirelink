# Canonical production URL (lib/site-config.ts) — used for sitemap/OG/canonical
# links. Falls back to NEXTAUTH_URL, then the known production domain, so this
# only needs to be set if the two ever diverge.
NEXT_PUBLIC_APP_URL=""

# Payments (lib/payments) — see lib/payments/index.ts for how these are used.
#
# Set USE_MOCK_PAYMENTS=true to use the in-memory mock provider for local
# development; no real payment account is needed in that case.
#
# Paystack is the active real provider.
USE_MOCK_PAYMENTS="true"

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Use a live secret key (sk_live_...) in production, test (sk_test_...) elsewhere.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Every price in this app is displayed in Naira (see lib/creator.ts's formatCents,
# which formats with Intl currency "NGN") — this MUST stay "NGN" to match, since a
# mismatch charges in a currency the merchant account likely isn't approved for and
# every transaction fails. Most Nigerian Paystack accounts are NGN-only.
PAYSTACK_CURRENCY="NGN"
#
# After deploying, register the webhook URL in the Paystack dashboard
# (Settings -> API Keys & Webhooks): https://<your-domain>/api/webhooks/paystack

# Live streaming (lib/livekit.ts) — https://cloud.livekit.io (free tier
# available). Leave unset to disable live streaming; the "Host" ring on Home
# and the /live routes show a friendly "not configured" state instead.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Provider rewards pool (app/api/cron/monthly-rewards) and the recurring
# billing renewal job (app/api/cron/subscription-renewals) — required in
# production to authorize the cron request (Authorization: Bearer
# <CRON_SECRET>). Left unset, these routes allow unauthenticated calls
# outside production only.
CRON_SECRET=""

# Email (lib/email) — https://resend.com, sending on the udala.pro domain.
# Leave unset to skip sending (logged and swallowed, never blocks the action
# that triggered it) — useful for local dev without a Resend account.
RESEND_API_KEY=""
# How long a signup/password-reset code stays valid.
EMAIL_OTP_TTL_MINUTES="10"

# Cloudflare Turnstile (lib/turnstile.ts) — bot protection on signup and
# forgot-password. https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset to skip verification entirely (useful for local dev).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_KEY=""

# Cloudflare R2 (lib/r2.ts) — storage for feed-post VIDEO only. Everything else
# (avatars, banners, verification docs, message media, and feed-post IMAGES)
# stays on Cloudinary, which still does real work for those (server-enforced
# resizing, HEIC conversion, immediate deletion for verification compliance).
# Leave any of these unset to fall back to the existing Cloudinary/local-disk
# path for video too - see uploadVideoDirect in lib/client-uploads.ts.
#
# Setup (dash.cloudflare.com -> R2):
#   1. Create a bucket, then an API token scoped to it (Object Read & Write)
#      for CLOUDFLARE_R2_ACCESS_KEY_ID / CLOUDFLARE_R2_SECRET_ACCESS_KEY.
#   2. CLOUDFLARE_R2_ENDPOINT is your account's S3 API endpoint, shown on the
#      bucket's "Settings" tab: https://<account-id>.r2.cloudflarestorage.com
#   3. Public read access — required, since post videos are served straight
#      from this URL — needs ONE of:
#        a) Bucket Settings -> Custom Domains -> connect one you control
#           (e.g. media.udala.pro). Recommended for production: no rate
#           limits, and it's the URL you set below.
#        b) Bucket Settings -> Public Access -> enable the r2.dev subdomain.
#           Fastest to set up, but Cloudflare marks it unsuitable for
#           production traffic.
#      Set CLOUDFLARE_R2_PUBLIC_URL to whichever one you picked.
#   4. Bucket Settings -> CORS Policy — required, since the browser uploads
#      directly to R2 with a PUT request. Without this the browser silently
#      blocks every upload. Allow PUT (and GET, for playback if using a
#      custom domain without its own CORS) from your app's origin(s):
#        [{ "AllowedOrigins": ["https://<your-domain>", "http://localhost:3000"],
#           "AllowedMethods": ["PUT", "GET"], "AllowedHeaders": ["Content-Type"] }]
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_URL=""
