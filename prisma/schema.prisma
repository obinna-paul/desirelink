generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---------------------------------------------------------------

enum DesireLevel {
  curious
  interested
  looking
  regular
  hard_limit
}

enum PrivacyLevel {
  public
  followers
  private
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum RsvpStatus {
  going
  interested
  waitlist
  not_going
}

enum RoomRole {
  admin
  member
}

enum RoomMemberStatus {
  pending
  approved
}

enum ReportStatus {
  pending
  reviewed
  resolved
}

enum AvailabilityStatusType {
  available_tonight
  out_tonight
  open_to_meeting
  chatting_only
  looking_for_event
  couple_looking
}

enum AccessApplicationStatus {
  pending
  approved
  denied
}

enum ModerationStatus {
  pending
  reviewed
  action_taken
}

enum ReportTargetType {
  profile
  message
  group_message
  post
  post_comment
  room_post
  event
}

enum PostType {
  standard
  event
  live
}

enum PostReactionType {
  like
}

enum ReviewContextType {
  event
  transaction
}

enum ChatChannelType {
  room
  event
}

enum VerificationRequestType {
  creator
  host
}

enum VerificationRequestStatus {
  pending
  approved
  denied
}

enum ProfileType {
  EXPLORER
  CREATOR
  PAIR
  SERVICE_PROVIDER
}

enum PartnerInviteStatus {
  pending
  accepted
  declined
  cancelled
}

// --- Auth ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  image         String?
  emailVerified DateTime?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile  Profile?
  accounts Account[]
  sessions Session[]
}

// NextAuth Prisma adapter models (Account/Session/VerificationToken) -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Profile & identity ----------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username    String @unique
  displayName String
  bio         String
  avatarUrl   String

  profileType       ProfileType @default(EXPLORER)
  serviceCategories String[]    @default([])
  paymentCustomerId String?     @unique

  partnerId String?
  partner   Profile?  @relation("ProfilePartner", fields: [partnerId], references: [id])
  partnerOf Profile[] @relation("ProfilePartner")

  partnerInvitesSent     PartnerInvite[] @relation("PartnerInviteSender")
  partnerInvitesReceived PartnerInvite[] @relation("PartnerInviteRecipient")

  gender      String
  orientation String

  locationLat Float
  locationLng Float
  city        String
  country     String

  openToChat        Boolean   @default(false)
  openToMeet        Boolean   @default(false)
  isIncognito       Boolean   @default(false)
  showInSearch      Boolean   @default(true)
  showExactLocation Boolean   @default(false)
  isVerified        Boolean   @default(false)
  isVerifiedCreator Boolean   @default(false)
  isVerifiedHost    Boolean   @default(false)
  isTrustedMember   Boolean   @default(false)
  isSuspended       Boolean   @default(false)
  suspendedAt       DateTime?
  warningCount      Int       @default(0)
  communityStanding Int       @default(0)
  profileViews      Int       @default(0)

  isMonetized        Boolean   @default(false)
  monetizedAt        DateTime?
  monetizationStatus String    @default("none")

  payoutProvider       String    @default("paystack")
  payoutRecipientCode  String?
  payoutSetupStatus    String    @default("not_started")
  payoutBankName       String?
  payoutAccountLast4   String?
  payoutAccountName    String?
  payoutCountry        String    @default("")
  payoutCurrency       String    @default("USD")
  payoutSetupUpdatedAt DateTime?

  /**
   * Spendable hearts balance, purchased with real money and spent sending gifts in live streams.
   */
  heartsBalance      Int       @default(0)
  /**
   * Withdrawable cash balance from gifts received while live, separate from the monthly rewards pool (ProviderEarning).
   */
  walletBalanceCents Int       @default(0)
  /**
   * Last time this profile was seen active in the app — powers the "online for chat" ring on Home without full presence infra.
   */
  lastActiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desires                Desire[]
  creatorTiers           CreatorTier[]
  subscriptionsAsSub     Subscription[]        @relation("SubscriptionSubscriber")
  subscriptionsAsCreator Subscription[]        @relation("SubscriptionCreator")
  hostedEvents           Event[]
  eventRsvps             EventRsvp[]
  sentMessages           Message[]             @relation("MessageSender")
  receivedMessages       Message[]             @relation("MessageRecipient")
  createdRooms           Room[]
  roomMemberships        RoomMember[]
  roomPosts              RoomPost[]
  posts                  Post[]
  postComments           PostComment[]
  postReactions          PostReaction[]
  postShares             PostShare[]
  blocksMade             Block[]               @relation("BlockBlocker")
  blocksReceived         Block[]               @relation("BlockBlocked")
  reportsMade            Report[]              @relation("ReportReporter")
  reportsReceived        Report[]              @relation("ReportReportedUser")
  circles                Circle[]
  circleMemberships      CircleMember[]
  availabilityStatuses   AvailabilityStatus[]
  accessApplications     AccessApplication[]
  transactions           Transaction[]
  reviewsGiven           Review[]              @relation("ReviewReviewer")
  reviewsReceived        Review[]              @relation("ReviewReviewee")
  groupMessages          GroupMessage[]
  chatMutesReceived      GroupChatMute[]       @relation("GroupChatMuteTarget")
  chatMutesIssued        GroupChatMute[]       @relation("GroupChatMuteIssuer")
  verificationRequests   VerificationRequest[]

  premiumSubscription             PremiumSubscription?
  providerSubscriptionsAsSub      ProviderSubscription[]    @relation("ProviderSubscriptionSubscriber")
  providerSubscriptionsAsProvider ProviderSubscription[]    @relation("ProviderSubscriptionProvider")
  providerEarnings                ProviderEarning[]
  engagementMetricsAsProvider     EngagementMetric[]        @relation("EngagementMetricProvider")
  engagementMetricsAsUser         EngagementMetric[]        @relation("EngagementMetricUser")
  paymentMethods                  PaymentMethod[]
  serviceListings                 ServiceListing[]
  monetizationApplications        MonetizationApplication[]

  liveStreams       LiveStream[]       @relation("LiveStreamProvider")
  giftsSent         Gift[]             @relation("GiftSender")
  giftsReceived     Gift[]             @relation("GiftReceiver")
  heartPurchases    HeartPurchase[]
  walletWithdrawals WalletWithdrawal[]

  @@index([city, country])
  @@index([profileType])
  @@index([profileType, isMonetized])
  @@index([locationLat, locationLng])
}

// --- Desires -----------------------------------------------------------------

model Desire {
  id        String       @id @default(cuid())
  userId    String
  profile   Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  level     DesireLevel
  privacy   PrivacyLevel
  createdAt DateTime     @default(now())

  @@unique([userId, category])
  @@index([userId])
  @@index([category])
}

// --- Partner linking (Pair accounts) ----------------------------------------

model PartnerInvite {
  id            String              @id @default(cuid())
  fromProfileId String
  fromProfile   Profile             @relation("PartnerInviteSender", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfileId   String
  toProfile     Profile             @relation("PartnerInviteRecipient", fields: [toProfileId], references: [id], onDelete: Cascade)
  status        PartnerInviteStatus @default(pending)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, status])
  @@index([fromProfileId, status])
}

// --- Creator monetization ---------------------------------------------------

model CreatorTier {
  id               String   @id @default(cuid())
  creatorId        String
  creator          Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name             String
  priceCents       Int
  tierType         String   @default("basic")
  description      String
  maxSubscribers   Int?
  isLimited        Boolean  @default(false)
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions         Subscription[]
  providerSubscriptions ProviderSubscription[]
  accessApplications    AccessApplication[]
  transactions          Transaction[]

  @@index([creatorId])
}

model Subscription {
  id           String             @id @default(cuid())
  subscriberId String
  subscriber   Profile            @relation("SubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creatorId    String
  creator      Profile            @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  tierId       String
  tier         CreatorTier        @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status       SubscriptionStatus
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime           @default(now())

  transactions Transaction[]

  @@index([subscriberId])
  @@index([creatorId])
  @@index([status])
}

model PremiumSubscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String
  paymentCustomerId     String?
  paymentSubscriptionId String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  pastDueSince          DateTime?
  paymentRetryCount     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
}

model ProviderSubscription {
  id                    String      @id @default(cuid())
  subscriberId          String
  subscriber            Profile     @relation("ProviderSubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  providerId            String
  provider              Profile     @relation("ProviderSubscriptionProvider", fields: [providerId], references: [id], onDelete: Cascade)
  tierId                String
  tier                  CreatorTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status                String
  paymentSubscriptionId String?
  cancelAtPeriodEnd     Boolean     @default(false)
  pastDueSince          DateTime?
  paymentRetryCount     Int         @default(0)
  startsAt              DateTime
  endsAt                DateTime
  createdAt             DateTime    @default(now())

  transactions Transaction[]

  @@index([subscriberId])
  @@index([providerId])
  @@index([status])
}

model ServiceListing {
  id              String   @id @default(cuid())
  providerId      String
  provider        Profile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String
  durationMinutes Int
  priceCents      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
}

model ProviderEarning {
  id              String    @id @default(cuid())
  providerId      String
  provider        Profile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  month           String
  points          Int       @default(0)
  amountCents     Int       @default(0)
  status          String    @default("pending")
  payoutReference String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@unique([providerId, month])
  @@index([providerId])
  @@index([month])
  @@index([status])
}

model EngagementMetric {
  id         String   @id @default(cuid())
  providerId String
  provider   Profile  @relation("EngagementMetricProvider", fields: [providerId], references: [id], onDelete: Cascade)
  userId     String?
  user       Profile? @relation("EngagementMetricUser", fields: [userId], references: [id], onDelete: SetNull)
  metricType String
  value      Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([metricType])
  @@index([createdAt])
}

model PaymentMethod {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String
  last4      String
  brand      String
  expMonth   Int
  expYear    Int
  country    String
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// --- Events ------------------------------------------------------------------

model Event {
  id               String   @id @default(cuid())
  hostId           String
  host             Profile  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title            String
  description      String
  eventType        String
  startTime        DateTime
  endTime          DateTime
  venueName        String
  address          String
  city             String   @default("")
  lat              Float
  lng              Float
  maxAttendees     Int?
  currentAttendees Int      @default(0)
  priceCents       Int      @default(0)
  isPrivate        Boolean  @default(false)
  coverImageUrl    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rsvps        EventRsvp[]
  transactions Transaction[]
  feedPosts    Post[]

  @@index([hostId])
  @@index([startTime])
}

model EventRsvp {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// --- Messaging ---------------------------------------------------------------

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      Profile   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Profile   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId])
  @@index([recipientId])
}

// --- Rooms / communities -------------------------------------------------

model Room {
  id            String   @id @default(cuid())
  name          String
  description   String
  isPrivate     Boolean  @default(false)
  coverImageUrl String
  createdById   String
  createdBy     Profile  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  members RoomMember[]
  posts   RoomPost[]

  @@index([createdById])
}

model RoomMember {
  id        String           @id @default(cuid())
  roomId    String
  room      Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoomRole
  status    RoomMemberStatus @default(approved)
  createdAt DateTime         @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model RoomPost {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mediaUrls Json
  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([authorId])
}

// --- Group chat (rooms & events) --------------------------------------------
// channelId is polymorphic (a Room.id or an Event.id depending on channelType),
// so it's a plain indexed string rather than a foreign key.

model GroupMessage {
  id          String          @id @default(cuid())
  channelType ChatChannelType
  channelId   String
  senderId    String
  sender      Profile         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime        @default(now())

  @@index([channelType, channelId])
  @@index([senderId])
}

model GroupChatMute {
  id          String          @id @default(cuid())
  channelType ChatChannelType
  channelId   String
  userId      String
  profile     Profile         @relation("GroupChatMuteTarget", fields: [userId], references: [id], onDelete: Cascade)
  mutedById   String
  mutedBy     Profile         @relation("GroupChatMuteIssuer", fields: [mutedById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([channelType, channelId, userId])
  @@index([channelType, channelId])
}

// --- Creator posts -------------------------------------------------------

model Post {
  id               String         @id @default(cuid())
  authorId         String
  author           Profile        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content          String
  mediaUrls        Json
  postType         PostType       @default(standard)
  eventId          String?
  event            Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isSubscriberOnly Boolean        @default(false)
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  comments         PostComment[]
  reactions        PostReaction[]
  shares           PostShare[]

  @@index([authorId])
  @@index([eventId])
  @@index([isArchived])
  @@index([postType])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model PostReaction {
  id        String           @id @default(cuid())
  postId    String
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PostReactionType @default(like)
  createdAt DateTime         @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

// --- Trust & safety --------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       Profile          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   Profile?         @relation("ReportReportedUser", fields: [reportedUserId], references: [id])
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String
  status         ReportStatus
  createdAt      DateTime         @default(now())

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([targetType, targetId])
}

model ModerationQueue {
  id             String           @id @default(cuid())
  contentType    String
  contentId      String
  contentOwnerId String?
  reporterId     String?
  reason         String
  details        String
  status         ModerationStatus
  action         String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([contentType, contentId])
  @@index([contentOwnerId])
  @@index([reporterId])
  @@index([status])
}

// --- Circles (granular visibility groups) -----------------------------------

model Circle {
  id          String   @id @default(cuid())
  userId      String
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  createdAt   DateTime @default(now())

  members     CircleMember[]
  permissions CirclePermission[]

  @@unique([userId, name])
  @@index([userId])
}

model CircleMember {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

model CirclePermission {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  fieldName String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([circleId, fieldName])
  @@index([circleId])
}

// --- Presence / availability -------------------------------------------------

model AvailabilityStatus {
  id        String                 @id @default(cuid())
  userId    String
  profile   Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AvailabilityStatusType
  expiresAt DateTime
  createdAt DateTime               @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --- Creator access & billing -----------------------------------------------

model AccessApplication {
  id        String                  @id @default(cuid())
  tierId    String
  tier      CreatorTier             @relation(fields: [tierId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AccessApplicationStatus
  createdAt DateTime                @default(now())

  @@unique([tierId, userId])
  @@index([tierId])
  @@index([userId])
}

model Transaction {
  id                     String                @id @default(cuid())
  userId                 String
  profile                Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId         String?
  subscription           Subscription?         @relation(fields: [subscriptionId], references: [id])
  tierId                 String?
  tier                   CreatorTier?          @relation(fields: [tierId], references: [id], onDelete: SetNull)
  eventId                String?
  event                  Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  providerSubscriptionId String?
  providerSubscription   ProviderSubscription? @relation(fields: [providerSubscriptionId], references: [id], onDelete: SetNull)
  isPremium              Boolean               @default(false)
  amountCents            Int
  status                 String
  provider               String
  createdAt              DateTime              @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([tierId])
  @@index([eventId])
  @@index([providerSubscriptionId])
}

model Review {
  id          String            @id @default(cuid())
  reviewerId  String
  reviewer    Profile           @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    Profile           @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  contextType ReviewContextType
  contextId   String
  rating      Int
  comment     String
  createdAt   DateTime          @default(now())

  @@unique([reviewerId, revieweeId, contextType, contextId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([contextType, contextId])
}

// --- Verification (creators & hosts) ----------------------------------------

model VerificationRequest {
  id          String                    @id @default(cuid())
  profileId   String
  profile     Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requestType VerificationRequestType
  govIdUrl    String
  selfieUrl   String
  status      VerificationRequestStatus @default(pending)
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([profileId])
  @@index([status])
  @@index([requestType, status])
}

// --- Provider monetization ---------------------------------------------------

model MonetizationApplication {
  id           String    @id @default(cuid())
  providerId   String
  provider     Profile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status       String    @default("pending")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([providerId])
  @@index([status])
}

// --- Live streaming & gifting -------------------------------------------------

model LiveStream {
  id                  String    @id @default(cuid())
  providerId          String
  provider            Profile   @relation("LiveStreamProvider", fields: [providerId], references: [id], onDelete: Cascade)
  title               String
  status              String    @default("live") // live | ended
  roomName            String    @unique
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  totalHeartsReceived Int       @default(0)
  createdAt           DateTime  @default(now())

  gifts Gift[]

  @@index([providerId])
  @@index([status])
}

model Gift {
  id                 String     @id @default(cuid())
  streamId           String
  stream             LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  senderId           String
  sender             Profile    @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId         String
  receiver           Profile    @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  hearts             Int
  /**
   * Cash value of the hearts at the platform's fixed conversion rate, before the platform's revenue-share cut.
   */
  valueCents         Int
  /**
   * Portion of valueCents credited to the receiver's withdrawable wallet balance.
   */
  providerShareCents Int
  createdAt          DateTime   @default(now())

  @@index([streamId])
  @@index([senderId])
  @@index([receiverId])
}

model HeartPurchase {
  id               String   @id @default(cuid())
  userId           String
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hearts           Int
  amountCents      Int
  status           String   @default("pending") // pending | succeeded | failed
  paymentReference String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model WalletWithdrawal {
  id              String    @id @default(cuid())
  providerId      String
  provider        Profile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amountCents     Int
  status          String    @default("pending") // pending | processing | paid | failed
  payoutReference String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([providerId])
  @@index([status])
}
