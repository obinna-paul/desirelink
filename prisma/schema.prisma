generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---------------------------------------------------------------

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum ServiceBookingStatus {
  pending_payment
  pending_provider
  confirmed
  declined
  cancelled
  completed
}

enum EscrowStatus {
  held
  released
  refunded
}

enum ReportStatus {
  pending
  reviewed
  resolved
}

enum AvailabilityStatusType {
  available_tonight
  out_tonight
  open_to_meeting
  chatting_only
  couple_looking
}

enum AccessApplicationStatus {
  pending
  approved
  denied
}

enum ModerationStatus {
  pending
  reviewed
  action_taken
}

enum ReportTargetType {
  profile
  message
  post
  post_comment
}

enum PostType {
  standard
  live
}

enum PostReactionType {
  like
}

enum ReviewContextType {
  transaction
}

enum MessageMediaType {
  image
  video
  audio
}

enum VerificationRequestType {
  creator
  service_provider
}

enum VerificationRequestStatus {
  pending
  approved
  denied
}

enum ProfileType {
  EXPLORER
  CREATOR
}

enum AdminRole {
  SUPPORT
  MODERATOR
  FINANCE
  SUPERADMIN
}

enum PartnerInviteStatus {
  pending
  accepted
  declined
  cancelled
}

// --- Auth ------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  name          String
  image         String?
  emailVerified DateTime?
  isAdmin       Boolean    @default(false)
  /**
   * Which admin console capabilities this user has - see lib/admin/access.ts. Null on an
   * isAdmin user is treated as SUPERADMIN (legacy/back-compat default) so flipping isAdmin
   * alone, as done before roles existed, never silently locks someone out.
   */
  adminRole     AdminRole?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  adminAuditLogs AdminAuditLog[]
  adminNotes     AdminNote[]
}

// NextAuth Prisma adapter models (Account/Session/VerificationToken) -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Profile & identity ----------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username       String  @unique
  usernameChosen Boolean @default(true)
  displayName    String
  bio            String
  avatarUrl      String
  bannerUrl      String  @default("")

  profileType       ProfileType @default(EXPLORER)
  serviceCategories String[]    @default([])
  paymentCustomerId String?     @unique

  partnerId String?
  partner   Profile?  @relation("ProfilePartner", fields: [partnerId], references: [id])
  partnerOf Profile[] @relation("ProfilePartner")

  partnerInvitesSent     PartnerInvite[] @relation("PartnerInviteSender")
  partnerInvitesReceived PartnerInvite[] @relation("PartnerInviteRecipient")

  gender      String
  orientation String

  locationLat Float
  locationLng Float
  city        String
  country     String

  openToChat                Boolean   @default(false)
  openToMeet                Boolean   @default(false)
  isIncognito               Boolean   @default(false)
  showInSearch              Boolean   @default(true)
  showExactLocation         Boolean   @default(false)
  showActivityStatus        Boolean   @default(true)
  isVerified                Boolean   @default(false)
  isVerifiedCreator         Boolean   @default(false)
  isVerifiedServiceProvider Boolean   @default(false)
  verificationPending       Boolean   @default(false)
  isTrustedMember           Boolean   @default(false)
  isSuspended               Boolean   @default(false)
  suspendedAt               DateTime?
  warningCount              Int       @default(0)
  communityStanding         Int       @default(0)
  profileViews              Int       @default(0)

  payoutProvider       String    @default("paystack")
  payoutRecipientCode  String?
  payoutSetupStatus    String    @default("not_started")
  payoutBankName       String?
  payoutAccountLast4   String?
  payoutAccountName    String?
  payoutCountry        String    @default("")
  payoutCurrency       String    @default("USD")
  payoutSetupUpdatedAt DateTime?

  /**
   * Spendable hearts balance, purchased with real money and spent sending gift hearts to providers.
   */
  heartsBalance      Int       @default(0)
  /**
   * Withdrawable cash balance from all provider earnings — gift hearts, tier subscriptions, and the
   * monthly rewards pool all credit this at their full value; a fee is only taken at withdrawal (see
   * WALLET_WITHDRAWAL_FEE_RATE in lib/wallet.ts).
   */
  walletBalanceCents Int       @default(0)
  /**
   * Last time this profile was seen active in the app — powers the "online for chat" ring on Home without full presence infra.
   */
  lastActiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorTiers           CreatorTier[]
  subscriptionsAsSub     Subscription[]        @relation("SubscriptionSubscriber")
  subscriptionsAsCreator Subscription[]        @relation("SubscriptionCreator")
  sentMessages           Message[]             @relation("MessageSender")
  receivedMessages       Message[]             @relation("MessageRecipient")
  posts                  Post[]
  postComments           PostComment[]
  postReactions          PostReaction[]
  postShares             PostShare[]
  blocksMade             Block[]               @relation("BlockBlocker")
  blocksReceived         Block[]               @relation("BlockBlocked")
  reportsMade            Report[]              @relation("ReportReporter")
  reportsReceived        Report[]              @relation("ReportReportedUser")
  circles                Circle[]
  circleMemberships      CircleMember[]
  availabilityStatuses   AvailabilityStatus[]
  accessApplications     AccessApplication[]
  transactions           Transaction[]
  reviewsGiven           Review[]              @relation("ReviewReviewer")
  reviewsReceived        Review[]              @relation("ReviewReviewee")
  verificationRequests   VerificationRequest[]
  adminNotes             AdminNote[]

  providerSubscriptionsAsSub      ProviderSubscription[] @relation("ProviderSubscriptionSubscriber")
  providerSubscriptionsAsProvider ProviderSubscription[] @relation("ProviderSubscriptionProvider")
  paymentMethods                  PaymentMethod[]
  serviceListings                 ServiceListing[]
  serviceBookingsAsProvider       ServiceBooking[]       @relation("ServiceBookingProvider")
  serviceBookingsAsCustomer       ServiceBooking[]       @relation("ServiceBookingCustomer")
  notificationsReceived           Notification[]         @relation("NotificationRecipient")
  notificationsActed              Notification[]         @relation("NotificationActor")

  liveStreams          LiveStream[]        @relation("LiveStreamProvider")
  liveRequestPresets   LiveRequestPreset[] @relation("LiveRequestPresetProvider")
  liveRequestsMade     LiveRequest[]       @relation("LiveRequestRequester")
  liveRequestsReceived LiveRequest[]       @relation("LiveRequestProvider")
  giftsSent            Gift[]              @relation("GiftSender")
  giftsReceived        Gift[]              @relation("GiftReceiver")
  heartPurchases       HeartPurchase[]
  walletWithdrawals    WalletWithdrawal[]

  @@index([city, country])
  @@index([profileType])
  @@index([locationLat, locationLng])
}

// --- Partner linking (Pair accounts) ----------------------------------------

model PartnerInvite {
  id            String              @id @default(cuid())
  fromProfileId String
  fromProfile   Profile             @relation("PartnerInviteSender", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfileId   String
  toProfile     Profile             @relation("PartnerInviteRecipient", fields: [toProfileId], references: [id], onDelete: Cascade)
  status        PartnerInviteStatus @default(pending)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, status])
  @@index([fromProfileId, status])
}

// --- Creator monetization ---------------------------------------------------

model CreatorTier {
  id               String   @id @default(cuid())
  creatorId        String
  creator          Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name             String
  priceCents       Int
  tierType         String   @default("basic")
  description      String
  maxSubscribers   Int?
  isLimited        Boolean  @default(false)
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions         Subscription[]
  providerSubscriptions ProviderSubscription[]
  accessApplications    AccessApplication[]
  transactions          Transaction[]

  @@index([creatorId])
}

model Subscription {
  id           String             @id @default(cuid())
  subscriberId String
  subscriber   Profile            @relation("SubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creatorId    String
  creator      Profile            @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  tierId       String
  tier         CreatorTier        @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status       SubscriptionStatus
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime           @default(now())

  transactions Transaction[]

  @@index([subscriberId])
  @@index([creatorId])
  @@index([status])
}

model ProviderSubscription {
  id                    String      @id @default(cuid())
  subscriberId          String
  subscriber            Profile     @relation("ProviderSubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  providerId            String
  provider              Profile     @relation("ProviderSubscriptionProvider", fields: [providerId], references: [id], onDelete: Cascade)
  tierId                String
  tier                  CreatorTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status                String
  paymentSubscriptionId String?
  cancelAtPeriodEnd     Boolean     @default(false)
  pastDueSince          DateTime?
  paymentRetryCount     Int         @default(0)
  startsAt              DateTime
  endsAt                DateTime
  createdAt             DateTime    @default(now())

  transactions Transaction[]

  @@index([subscriberId])
  @@index([providerId])
  @@index([status])
}

model ServiceListing {
  id              String   @id @default(cuid())
  providerId      String
  provider        Profile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String
  durationMinutes Int
  priceCents      Int
  coverImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings ServiceBooking[]

  @@index([providerId])
}

/**
 * A booking request against a ServiceListing. Created as "pending_payment"
 * the instant a customer requests a slot (see
 * app/api/service-listings/[id]/book/route.ts); once the charge succeeds it
 * moves to "pending_provider" and the funds are held in escrow on the linked
 * Transaction — the provider must accept or decline before the requested
 * time. Funds only reach the provider's wallet once the customer confirms
 * completion, or the release-escrow cron auto-releases after the scheduled
 * time plus a grace period. Declining or cancelling refunds the customer in
 * full.
 */
model ServiceBooking {
  id          String               @id @default(cuid())
  listingId   String
  listing     ServiceListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Profile              @relation("ServiceBookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Profile              @relation("ServiceBookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  requestedAt DateTime
  note        String               @default("")
  priceCents  Int
  status      ServiceBookingStatus @default(pending_payment)

  declineReason String?
  respondedAt   DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction?

  @@index([listingId])
  @@index([providerId])
  @@index([customerId])
  @@index([status])
}

model PaymentMethod {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String
  last4      String
  brand      String
  expMonth   Int
  expYear    Int
  country    String
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// --- Messaging ---------------------------------------------------------------

model Message {
  id                   String            @id @default(cuid())
  senderId             String
  sender               Profile           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId          String
  recipient            Profile           @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content              String
  mediaUrl             String?
  mediaType            MessageMediaType?
  mediaMimeType        String?
  mediaWidth           Int?
  mediaHeight          Int?
  mediaDurationSeconds Float?
  replyToId            String?
  replyTo              Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies              Message[]         @relation("MessageReplies")
  createdAt            DateTime          @default(now())
  readAt               DateTime?

  @@index([senderId])
  @@index([recipientId])
  @@index([replyToId])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   Profile   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Profile?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String
  title       String
  body        String
  href        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// --- Creator posts -------------------------------------------------------

model Post {
  id               String         @id @default(cuid())
  authorId         String
  author           Profile        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content          String
  mediaUrls        Json
  postType         PostType       @default(standard)
  isSubscriberOnly Boolean        @default(false)
  isArchived       Boolean        @default(false)
  viewCount        Int            @default(0)
  pinnedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  comments         PostComment[]
  reactions        PostReaction[]
  shares           PostShare[]

  @@index([authorId])
  @@index([isArchived])
  @@index([postType])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model PostReaction {
  id        String           @id @default(cuid())
  postId    String
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PostReactionType @default(like)
  createdAt DateTime         @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

// --- Trust & safety --------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       Profile          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   Profile?         @relation("ReportReportedUser", fields: [reportedUserId], references: [id])
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String
  status         ReportStatus
  createdAt      DateTime         @default(now())

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([targetType, targetId])
}

model ModerationQueue {
  id             String           @id @default(cuid())
  contentType    String
  contentId      String
  contentOwnerId String?
  reporterId     String?
  reason         String
  details        String
  status         ModerationStatus
  action         String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([contentType, contentId])
  @@index([contentOwnerId])
  @@index([reporterId])
  @@index([status])
}

// --- Circles (granular visibility groups) -----------------------------------

model Circle {
  id          String   @id @default(cuid())
  userId      String
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  createdAt   DateTime @default(now())

  members     CircleMember[]
  permissions CirclePermission[]

  @@unique([userId, name])
  @@index([userId])
}

model CircleMember {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

model CirclePermission {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  fieldName String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([circleId, fieldName])
  @@index([circleId])
}

// --- Presence / availability -------------------------------------------------

model AvailabilityStatus {
  id        String                 @id @default(cuid())
  userId    String
  profile   Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AvailabilityStatusType
  expiresAt DateTime
  createdAt DateTime               @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --- Creator access & billing -----------------------------------------------

model AccessApplication {
  id        String                  @id @default(cuid())
  tierId    String
  tier      CreatorTier             @relation(fields: [tierId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AccessApplicationStatus
  createdAt DateTime                @default(now())

  @@unique([tierId, userId])
  @@index([tierId])
  @@index([userId])
}

model Transaction {
  id                     String                @id @default(cuid())
  userId                 String
  profile                Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId         String?
  subscription           Subscription?         @relation(fields: [subscriptionId], references: [id])
  tierId                 String?
  tier                   CreatorTier?          @relation(fields: [tierId], references: [id], onDelete: SetNull)
  providerSubscriptionId String?
  providerSubscription   ProviderSubscription? @relation(fields: [providerSubscriptionId], references: [id], onDelete: SetNull)
  serviceBookingId       String?               @unique
  serviceBooking         ServiceBooking?       @relation(fields: [serviceBookingId], references: [id], onDelete: SetNull)
  amountCents            Int
  status                 String
  provider               String
  /**
   * The payment provider's own charge reference (Paystack's `reference`) — needed to issue a refund against this specific charge. Null for legacy rows recorded before this field existed.
   */
  providerReference      String?
  createdAt              DateTime              @default(now())

  /**
   * Set only for payments that go through escrow (service bookings) — null
   * for everything else (hearts, creator-tier subscriptions), which credit
   * the recipient's wallet immediately on success. "held" funds are not yet
   * in the provider's wallet; "released" means they've been credited;
   * "refunded" means they went back to the customer.
   */
  escrowStatus     EscrowStatus?
  escrowReleasedAt DateTime?

  @@index([userId])
  @@index([subscriptionId])
  @@index([tierId])
  @@index([providerSubscriptionId])
  @@index([escrowStatus])
}

/**
 * Idempotency ledger for payment-provider events (webhook deliveries and the
 * synchronous post-redirect verify() calls that construct the same event
 * shape) — see lib/payments/webhook-handler.ts's processPaymentEvent. A row
 * is inserted in the same transaction as the state change it guards, so a
 * duplicate delivery of the same event is a guaranteed no-op rather than a
 * race between reading and writing business state.
 */
model ProcessedPaymentEvent {
  id        String   @id @default(cuid())
  provider  String
  eventType String
  reference String
  createdAt DateTime @default(now())

  @@unique([provider, eventType, reference])
}

model Review {
  id          String            @id @default(cuid())
  reviewerId  String
  reviewer    Profile           @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId  String
  reviewee    Profile           @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  contextType ReviewContextType
  contextId   String
  rating      Int
  comment     String
  createdAt   DateTime          @default(now())

  @@unique([reviewerId, revieweeId, contextType, contextId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([contextType, contextId])
}

// --- Verification (creators & service providers) ---------------------------

model VerificationRequest {
  id             String                    @id @default(cuid())
  profileId      String
  profile        Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requestType    VerificationRequestType
  govIdUrl       String
  selfieUrl      String
  status         VerificationRequestStatus @default(pending)
  reviewerId     String?
  reviewedAt     DateTime?
  /**
   * Set once the ID photo and selfie video are purged from Cloudinary after review - the
   * privacy policy promises immediate deletion, so this is what makes that provable. See
   * deleteVerificationMedia in lib/verification.ts.
   */
  mediaDeletedAt DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([profileId])
  @@index([status])
  @@index([requestType, status])
}

// --- Live streaming & gifting -------------------------------------------------

model LiveStream {
  id                  String    @id @default(cuid())
  providerId          String
  provider            Profile   @relation("LiveStreamProvider", fields: [providerId], references: [id], onDelete: Cascade)
  title               String
  status              String    @default("live") // live | ended
  roomName            String    @unique
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  totalHeartsReceived Int       @default(0)
  heartGoal           Int?
  peakViewers         Int       @default(0)
  completedRequests   Int       @default(0)
  createdAt           DateTime  @default(now())

  gifts          Gift[]
  requestOptions LiveRequestOption[]
  requests       LiveRequest[]

  @@index([providerId])
  @@index([status])
}

model LiveRequestPreset {
  id         String   @id @default(cuid())
  providerId String
  provider   Profile  @relation("LiveRequestPresetProvider", fields: [providerId], references: [id], onDelete: Cascade)
  label      String
  hearts     Int
  sortOrder  Int      @default(0)
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([providerId, sortOrder])
}

model LiveRequestOption {
  id        String     @id @default(cuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  label     String
  hearts    Int
  sortOrder Int        @default(0)
  isEnabled Boolean    @default(true)
  createdAt DateTime   @default(now())

  requests LiveRequest[]

  @@index([streamId, sortOrder])
}

enum LiveRequestStatus {
  pending
  accepted
  completed
  declined
  expired
  refunded
}

model LiveRequest {
  id          String            @id @default(cuid())
  streamId    String
  stream      LiveStream        @relation(fields: [streamId], references: [id], onDelete: Cascade)
  optionId    String
  option      LiveRequestOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  requesterId String
  requester   Profile           @relation("LiveRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Profile           @relation("LiveRequestProvider", fields: [providerId], references: [id], onDelete: Cascade)
  label       String
  hearts      Int
  valueCents  Int
  status      LiveRequestStatus @default(pending)
  expiresAt   DateTime
  respondedAt DateTime?
  completedAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([streamId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([providerId, status])
}

model Gift {
  id         String      @id @default(cuid())
  /**
   * Set only when context is "live_stream" — hearts can also be sent from a provider's profile or from a chat.
   */
  streamId   String?
  stream     LiveStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  senderId   String
  sender     Profile     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Profile     @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  hearts     Int
  /**
   * Cash value of the hearts at the platform's fixed conversion rate. Credited to the receiver's wallet in full — the platform takes its cut as a fee when the wallet is withdrawn, not here.
   */
  valueCents Int
  /**
   * Where this gift was sent from: "live_stream" | "profile" | "chat".
   */
  context    String      @default("live_stream")
  createdAt  DateTime    @default(now())

  @@index([streamId])
  @@index([senderId])
  @@index([receiverId])
}

model HeartPurchase {
  id               String   @id @default(cuid())
  userId           String
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hearts           Int
  amountCents      Int
  status           String   @default("pending") // pending | succeeded | failed
  paymentReference String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model WalletWithdrawal {
  id              String    @id @default(cuid())
  providerId      String
  provider        Profile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /**
   * Gross amount debited from the wallet, before the withdrawal fee.
   */
  amountCents     Int
  /**
   * Platform fee taken at withdrawal time (see WALLET_WITHDRAWAL_FEE_RATE in lib/wallet.ts).
   */
  feeCents        Int       @default(0)
  /**
   * amountCents - feeCents — what actually gets transferred to the provider's bank.
   */
  netAmountCents  Int       @default(0)
  status          String    @default("pending") // pending | processing | paid | failed
  payoutReference String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([providerId])
  @@index([status])
}

// --- Admin console -----------------------------------------------------------

/**
 * Append-only record of every privileged action AND every sensitive read (opening a
 * verification document, a paywalled post, etc.) taken through the admin console. Never
 * updated or deleted once written - see lib/admin/audit.ts.
 */
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/**
 * A case note an admin leaves on an account - the shared context a support/moderation
 * team needs that shouldn't live only in one person's head.
 */
model AdminNote {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([profileId])
}
